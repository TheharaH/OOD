<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" prefHeight="600.0" prefWidth="800.0" spacing="20" style="-fx-background-color: #d0d4ed;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.ood.AddController">

    <!-- Header Label -->
    <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="ADD AN ARTICLE" />

    <!-- Article Title TextField -->
    <TextField fx:id="titleTextField" prefHeight="50.0" prefWidth="700.0" promptText="Enter article title" style="-fx-font-size: 16px;" />

    <!-- Article Content TextField -->
    <TextField fx:id="contentTextField" prefHeight="250.0" prefWidth="700.0" promptText="Enter article content" style="-fx-font-size: 16px;" />

    <!-- Save Article Button -->
    <Button onAction="#saveArticle" prefHeight="40.0" prefWidth="700.0" text="Save Article" style="-fx-background-color: #172a75; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;" />

    <!-- Back Button -->
    <Button onAction="#handleBackButton" prefHeight="40.0" prefWidth="700.0" text="Back" style="-fx-background-color: #172a75; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;" />
</VBox>