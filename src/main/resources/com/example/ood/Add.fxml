<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" prefHeight="594.0" prefWidth="746.0" spacing="10" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.ood.AddController">
    <TextField fx:id="titleTextField" promptText="Enter article title" />
    <TextField fx:id="contentTextField" promptText="Enter article content" />

    <!-- Button to save the article -->
    <Button text="Save Article" onAction="#saveArticle" />
    <Button text="Back" onAction="#handleBackButton" />
</VBox>
