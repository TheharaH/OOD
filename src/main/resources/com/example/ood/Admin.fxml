<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" prefHeight="594.0" prefWidth="746.0" spacing="10" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.ood.AdminController">
    <!-- Welcome message for the admin -->
    <Label style="-fx-font-size: 24px;" text="Welcome Admin!" />
     <Button onAction="#handleBackButton" text="Back" />
    <Button fx:id="AddButton" layoutX="220.0" layoutY="200.0" text="ADD" onAction="#goToAddArticle" />
    <Button fx:id="DeleteButton" layoutX="220.0" layoutY="200.0" text="DELETE" onAction="#goToDeleteArticle" />
</VBox>
