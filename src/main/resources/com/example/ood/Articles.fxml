<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- Import ComboBox -->

<VBox alignment="TOP_CENTER" prefHeight="600.0" prefWidth="800.0" spacing="20" style="-fx-background-color: #d0d4ed;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.ood.ArticlesController">
    <!-- Title Label -->
    <Label style="-fx-font-size: 28px; -fx-font-weight: bold;" text="Top Articles" />

    <!-- ComboBox for category selection with the same color style -->
    <ComboBox fx:id="categoryComboBox" prefWidth="300.0" style="-fx-font-size: 14px;" />

    <!-- List of article titles with matching size and style -->
    <ListView fx:id="articlesListView" prefHeight="309.0" prefWidth="746.0" style="-fx-font-size: 16px;" />

    <!-- Back button with same colors and style as previous buttons -->
    <Button fx:id="backButton" onAction="#handleBackButton" text="Back" style="-fx-font-size: 16px; -fx-background-color: #172a75; -fx-text-fill: white;" />

    <!-- Spacer for alignment -->
    <HBox alignment="CENTER" />
</VBox>
