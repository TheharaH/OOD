<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- Import ComboBox -->

<VBox alignment="TOP_CENTER" prefHeight="472.0" prefWidth="746.0" spacing="10" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.ood.ArticlesController">
    <Label style="-fx-font-size: 24px;" text="Top Articles" />

    <!-- ComboBox for category selection -->
    <ComboBox fx:id="categoryComboBox" prefWidth="300.0" />

    <!-- List of article titles -->
    <ListView fx:id="articlesListView" prefHeight="309.0" prefWidth="746.0" />
     <Button onAction="#handleBackButton" text="Back" />

    <!-- Back button to return to the home view -->
    <HBox alignment="CENTER" />
</VBox>
