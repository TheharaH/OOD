<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" prefHeight="600.0" prefWidth="800.0" spacing="20" style="-fx-background-color: #d0d4ed;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.ood.RecommendedArticlesController">


    <Label style="-fx-font-size: 28px; -fx-font-weight: bold;" text="Personalized Articles" />


    <ListView fx:id="articlesListView" prefHeight="400.0" prefWidth="700.0" style="-fx-font-size: 16px;" onMouseClicked="#handleArticleClick" />


    <Button fx:id="backButton" onAction="#handleBackButton" text="Back" style="-fx-font-size: 16px; -fx-background-color: #172a75; -fx-text-fill: white;" />


    <HBox alignment="CENTER" />
</VBox>
