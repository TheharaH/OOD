<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" prefHeight="600.0" prefWidth="800.0" spacing="20" style="-fx-background-color: #d0d4ed;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.ood.RecommendedArticleDetailController">


    <Label fx:id="titleLabel" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" wrapText="true" prefWidth="700.0" />


    <Label fx:id="categoryLabel" style="-fx-font-size: 16px; -fx-text-fill: #7f8c8d;" wrapText="true" prefWidth="700.0" />


    <Label fx:id="contentLabel" style="-fx-font-size: 18px; -fx-text-fill: #34495e;" wrapText="true" prefWidth="700.0" />


    <Button fx:id="likeButton" text="Like" onAction="#handleLikeButton" prefHeight="40.0" prefWidth="200.0" style="-fx-background-color: #53c68c; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;" />
    <Button fx:id="skipButton" text="Skip" onAction="#handleSkipButton" prefHeight="40.0" prefWidth="200.0" style="-fx-background-color: #ff8080; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;" />
    <Button text="Back" onAction="#handleBackButton" prefHeight="40.0" prefWidth="200.0" style="-fx-background-color: #172a75; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;" />

</VBox>
