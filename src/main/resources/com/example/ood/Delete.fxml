<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" prefHeight="594.0" prefWidth="746.0" spacing="10" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.ood.DeleteController">
    <!-- List of articles to select for deletion -->
    <ListView fx:id="articleListView" prefHeight="347.0" prefWidth="300.0" />

    <!-- Button to delete the selected article -->
    <Button text="Delete Article" onAction="#deleteArticle" />

    <!-- Back button to return to the admin page -->
    <Button text="Back" onAction="#handleBackButton" />
</VBox>
