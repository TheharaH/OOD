<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" style="-fx-background-color: #d0d4ed;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.ood.ReadingHistoryController">
    <children>

        <Label layoutX="280.0" layoutY="30.0" style="-fx-font-size: 28px; -fx-font-weight: bold;" text="Reading History" />


        <ListView fx:id="historyListView" layoutX="50.0" layoutY="100.0" prefHeight="400.0" prefWidth="700.0" style="-fx-font-size: 16px;" />


        <Button layoutX="50.0" layoutY="520.0" onAction="#handleBackButton" text="Back" style="-fx-font-size: 16px; -fx-background-color: #172a75; -fx-text-fill: white;" />
    </children>
</AnchorPane>
