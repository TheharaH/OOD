    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <AnchorPane prefHeight="200.0" prefWidth="200.0">
        <children>
            <Button layoutX="344.0" layoutY="93.0" mnemonicParsing="false" onAction="#handleSignup" text="SIGNUP" />
            <Button layoutX="84.0" layoutY="93.0" mnemonicParsing="false" onAction="#handleLogin" text="LOGIN" />
            <Button layoutX="386.0" layoutY="1.0" mnemonicParsing="false" onAction="#handleAdmin" text="ADMIN" />
