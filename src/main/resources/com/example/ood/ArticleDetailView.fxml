<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" prefHeight="600.0" prefWidth="800.0" spacing="20" style="-fx-background-color: #d0d4ed;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.ood.ArticleDetailController">

    <!-- Article Title -->
    <Label fx:id="titleLabel" prefWidth="700.0" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" wrapText="true" />

    <!-- Article Category -->
    <Label fx:id="categoryLabel" prefWidth="700.0" style="-fx-font-size: 16px; -fx-text-fill: #7f8c8d;" wrapText="true" />

    <!-- Article Content -->
    <Label fx:id="contentLabel" prefWidth="700.0" style="-fx-font-size: 18px; -fx-text-fill: #34495e;" wrapText="true" />
    <Button fx:id="likeButton" onAction="#handleLikeButton" prefHeight="40.0" prefWidth="200.0" style="-fx-background-color: #53c68c; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;" text="Like" />
    <Button fx:id="skipButton" onAction="#handleSkipButton" prefHeight="40.0" prefWidth="200.0" style="-fx-background-color: #ff8080; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;" text="Skip" />

    <!-- Buttons -->
    <Button onAction="#handleBackButton" prefHeight="40.0" prefWidth="200.0" style="-fx-background-color: #172a75; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;" text="Back" />

</VBox>
