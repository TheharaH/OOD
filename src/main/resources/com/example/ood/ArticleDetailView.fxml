<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="466.0" prefWidth="325.0" spacing="10" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.ood.ArticleDetailController">
    <Label fx:id="titleLabel" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
    <Label fx:id="categoryLabel" style="-fx-font-size: 14px; -fx-text-fill: gray;" />
    <Label fx:id="contentLabel" style="-fx-font-size: 16px;" wrapText="true" />
    <Button onAction="#handleBackButton" text="Back" />
    <Button mnemonicParsing="false" text="Like" />
</VBox>
