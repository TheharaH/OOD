<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>

<VBox spacing="10" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="com.example.ood.ArticleDetailController">
    <Label fx:id="titleLabel" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
    <Label fx:id="categoryLabel" style="-fx-font-size: 14px; -fx-text-fill: gray;" />
    <Label fx:id="contentLabel" wrapText="true" style="-fx-font-size: 16px;" />
    <Button text="Back" onAction="#handleBackButton" />
</VBox>
